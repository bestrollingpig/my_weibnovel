							<제목><페이지 number="ITKC_KO_C005A_V001_296C"/>李喜茂</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>홍의호</한글성명>
								<한자성명>洪義浩</한자성명>
							</저자>
