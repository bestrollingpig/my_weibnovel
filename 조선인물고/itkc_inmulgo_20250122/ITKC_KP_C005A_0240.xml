							<제목><페이지 number="ITKC_KO_C005A_V002_434A"/>洪重普</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>황기천</한글성명>
								<한자성명>黃基天</한자성명>
							</저자>
						</저자정보>
