							<제목><페이지 number="ITKC_KO_C005A_V001_207A"/>尹順之</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>이익진</한글성명>
								<한자성명>李翼晉</한자성명>
							</저자>
							<저자>
								<한글성명>홍의호</한글성명>
								<한자성명>洪義浩</한자성명>
							</저자>
