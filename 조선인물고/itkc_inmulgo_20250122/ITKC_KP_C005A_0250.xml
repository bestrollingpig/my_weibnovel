<레벨4 DCI="ITKC_KP_C005A_0250_070_0050_2023_003_XML" id="ITKC_KP_C005A_0250_070_0050" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_494C"/>金時敏</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>김계온</한글성명>
								<한자성명>金啓溫</한자성명>
