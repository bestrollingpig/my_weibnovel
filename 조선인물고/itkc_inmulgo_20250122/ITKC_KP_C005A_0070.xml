							<제목><페이지 number="ITKC_KO_C005A_V001_320C"/>尹知敬</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>김희락</한글성명>
								<한자성명>金熙洛</한자성명>
							</저자>
							<저자>
								<한글성명>윤광안</한글성명>
								<한자성명>尹光顔</한자성명>
							</저자>
						</저자정보>
