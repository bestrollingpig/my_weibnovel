						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_406A"/>金壽興 <원주>文翼公｡</원주></제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>홍석주</한글성명>
								<한자성명>洪奭周</한자성명>
							</저자>
						</저자정보>
