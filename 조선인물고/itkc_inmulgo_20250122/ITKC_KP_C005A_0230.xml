						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_416A"/>尹世紀</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>홍석주</한글성명>
