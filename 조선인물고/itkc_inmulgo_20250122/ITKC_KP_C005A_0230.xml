					</연계정보>
				</레벨4>
<레벨4 DCI="ITKC_KP_C005A_0230_020_0370_2023_003_XML" id="ITKC_KP_C005A_0230_020_0370" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_428A"/>李尙眞 <원주>忠貞公｡</원주></제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>홍석주</한글성명>
								<한자성명>洪奭周</한자성명>
							</저자>
						</저자정보>
