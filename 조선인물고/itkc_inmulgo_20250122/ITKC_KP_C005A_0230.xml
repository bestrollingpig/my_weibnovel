<레벨4 DCI="ITKC_KP_C005A_0230_010_0040_2023_003_XML" id="ITKC_KP_C005A_0230_010_0040" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_385A"/>申翊全</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>홍석주</한글성명>
								<한자성명>洪奭周</한자성명>
