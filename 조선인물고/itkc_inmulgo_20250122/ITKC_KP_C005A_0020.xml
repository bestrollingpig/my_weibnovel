<레벨4 DCI="ITKC_KP_C005A_0020_020_0020_2023_001_XML" id="ITKC_KP_C005A_0020_020_0020" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V001_120A"/>宋浚吉 <원주>文正公｡</원주></제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>김조순</한글성명>
								<한자성명>金祖淳</한자성명>
							</저자>
						</저자정보>
