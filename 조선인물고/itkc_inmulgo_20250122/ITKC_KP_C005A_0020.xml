					</연계정보>
				</레벨4>
<레벨4 DCI="ITKC_KP_C005A_0020_010_0130_2023_001_XML" id="ITKC_KP_C005A_0020_010_0130" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V001_101A"/>沈益顯</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
