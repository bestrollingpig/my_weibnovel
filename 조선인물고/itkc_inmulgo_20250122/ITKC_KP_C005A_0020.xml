							<제목><페이지 number="ITKC_KO_C005A_V001_107C"/>權大任</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>김조순</한글성명>
								<한자성명>金祖淳</한자성명>
							</저자>
						</저자정보>
