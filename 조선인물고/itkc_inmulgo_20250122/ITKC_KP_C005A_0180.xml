						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_188A"/>權徵</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>조석중</한글성명>
								<한자성명>曺錫中</한자성명>
							</저자>
						</저자정보>
