					</연계정보>
				</레벨4>
<레벨4 DCI="ITKC_KP_C005A_0180_010_0150_2023_002_XML" id="ITKC_KP_C005A_0180_010_0150" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_169A"/>李彦忱</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>조석중</한글성명>
								<한자성명>曺錫中</한자성명>
							</저자>
						</저자정보>
