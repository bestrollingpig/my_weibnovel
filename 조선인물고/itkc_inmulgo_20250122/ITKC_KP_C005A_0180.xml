<레벨4 DCI="ITKC_KP_C005A_0180_010_0020_2023_002_XML" id="ITKC_KP_C005A_0180_010_0020" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_158A"/>閔齊仁</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>조석중</한글성명>
								<한자성명>曺錫中</한자성명>
							</저자>
						</저자정보>
						<간행정보>
							<집수번호>C019</집수번호>
						</간행정보>
						<분류정보>
							<분류항목 type="문체분류">
								<분류내용 type="대분류">傳記類</분류내용>
								<분류내용 type="중분류">其他類</분류내용>
							</분류항목>
						</분류정보>
