					</연계정보>
				</레벨4>
<레벨4 DCI="ITKC_KP_C005A_0180_010_0050_2023_002_XML" id="ITKC_KP_C005A_0180_010_0050" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
