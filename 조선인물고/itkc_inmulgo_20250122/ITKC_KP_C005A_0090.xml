						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V001_412C"/>趙宗著</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>윤광안</한글성명>
								<한자성명>尹光顔</한자성명>
							</저자>
