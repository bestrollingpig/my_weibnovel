<레벨4 DCI="ITKC_KP_C005A_0170_020_0300_2023_002_XML" id="ITKC_KP_C005A_0170_020_0300" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_125A"/>權敏手</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
							<저자>
								<한글성명>이면승</한글성명>
								<한자성명>李勉昇</한자성명>
							</저자>
						</저자정보>
						<간행정보>
							<집수번호>C019</집수번호>
						</간행정보>
						<분류정보>
							<분류항목 type="문체분류">
								<분류내용 type="대분류">傳記類</분류내용>
								<분류내용 type="중분류">其他類</분류내용>
							</분류항목>
						</분류정보>
					</메타정보>
					<본문정보>
						<내용>
<단락 align="left" indent="0"><고유명사 type="">權敏手</고유명사>字<고유명사 type="">叔達</고유명사>, <고유명사 type="">安東</고유명사>人｡ <고유명사 type="">成化</고유명사>丙戌生｡ <고유명사 type="">成廟</고유명사>甲寅登第, 歷弘文正字、兩司直提學･副提學、承旨、大司憲、<고유명사 type="">忠淸</고유명사>觀察使｡ 丁丑卒, 年五十二｡</단락>
<단락 align="left" indent="2">幼與弟<고유명사 type="">達手</고유명사>俱有雋才, 以文選之學爲諸生倡｡</단락>
<단락 align="left" indent="2">甲子獄起, 弟<고유명사 type="">達手</고유명사>抗議觸諱而死, 公亦坐直言, 遠竄嶺外｡ <고유명사 type="">中廟</고유명사>改玉, 始起｡</단락>
<단락 align="left" indent="2">公識高而氣亢, 厭世囂囂, 頗欲矯而正之｡ 見人爲不善, 唾之如將浼己, 不喜公者, 用是爲謗, 公恬然曰: “自有知者知之耳｡”</단락>
<단락 align="left" indent="2"><페이지 number="ITKC_KO_C005A_V002_125B"/>季弟<고유명사 type="">价手</고유명사>窮不自振, 公以父母遺産悉推與之｡</단락>
<단락 align="left" indent="2">在<고유명사 type="">忠淸</고유명사>也, 盡心民事, 至廢寢食｡ 所親知其將病, 勸令怡養, 答曰: “受命於君, 托疾自便, 在他人尙且惡之, 況敢效尤乎?” <원주>竝<고유명사 type="">南衮</고유명사>撰墓碣｡</원주></단락>
						</내용>
