<레벨4 DCI="ITKC_KP_C005A_0170_020_0320_2023_002_XML" id="ITKC_KP_C005A_0170_020_0320" type="최종정보" 자료생성일="2023-12-15">
					<메타정보>
						<제목정보>
							<제목><페이지 number="ITKC_KO_C005A_V002_126C"/>韓亨允</제목>
						</제목정보>
						<저자정보 type="필자" 복수구분="">
